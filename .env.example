# Database
# PostgreSQL 数据库密码；docker-compose 和本地连接会使用该值
DB_PASSWORD=changeme

# Flask
# Flask 应用密钥，用于会话、签名等安全能力；生产环境需使用强随机值
SECRET_KEY=generate-a-random-secret-key
# JWT 登录令牌有效期，单位为小时
JWT_EXPIRATION_HOURS=24
# Flask 运行环境标识；本地开发使用 development，生产环境使用 production
FLASK_ENV=production

# Upload
# 图片上传保存目录；相对路径会基于启动应用时的工作目录解析
UPLOAD_FOLDER=uploads
# 单个上传请求的最大体积，单位为字节
MAX_CONTENT_LENGTH=5242880

# Admin
# 初始化管理员用户名
ADMIN_USERNAME=admin
# 初始化管理员邮箱
ADMIN_EMAIL=admin@example.com
# 初始化管理员密码；生产环境首次部署前必须修改
ADMIN_PASSWORD=changeme
