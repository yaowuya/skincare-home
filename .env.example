# Database
# DATABASE_URL 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
# 本地开发示例：mysql+pymysql://root:root@localhost:3306/skincare
# Docker 部署：修改为线上数据库连接串
# 注意：密码中的特殊字符需 URL 编码，如 @ → %40
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/skincare

# Flask
# Flask 应用密钥，用于会话、签名等安全能力；⚠️ 生产环境必须替换为强随机值（如 openssl rand -hex 32）
SECRET_KEY=generate-a-random-secret-key
# JWT 签名密钥；⚠️ 生产环境必须替换为强随机值；docker-compose 中默认取 SECRET_KEY 的值
# JWT_SECRET=generate-a-random-jwt-secret
# JWT 登录令牌有效期，单位为小时
JWT_EXPIRATION_HOURS=24

# Upload
# 图片上传保存目录；相对路径会基于启动应用时的工作目录解析
# UPLOAD_FOLDER=uploads
# 单个上传请求的最大体积，单位为字节
MAX_CONTENT_LENGTH=5242880

# Admin
# 初始化管理员用户名
ADMIN_USERNAME=admin
# 初始化管理员邮箱
ADMIN_EMAIL=admin@example.com
# 初始化管理员密码；⚠️ 生产环境首次部署前必须修改
ADMIN_PASSWORD=changeme

# Gunicorn（仅 Docker 部署时生效）
# Gunicorn 工作进程数，默认 4
# GUNICORN_WORKERS=4

# Port（仅 Docker 部署时生效）
# 宿主机映射端口，默认 5000
# PORT=5000
